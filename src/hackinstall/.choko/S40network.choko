#!/bin/sh
#
# Start the network....
# Choko Hack v13.3.0

# Debian ifupdown needs the /run/network lock directory
mkdir -p /run/network

case "$1" in
  start)
    # No network in USB Joystick Mode (check js2hid2, S20usbcheck may have already deleted controller.txt)
    if [ -n "$(pidof js2hid2)" ]
    then
      echo "USB Joystick Mode: network not started"
      exit 0
    fi

    if ! iw dev wlan0 link | grep -q "Connected to";
    then
      printf "Starting network: "
      # Only bring up interfaces that exist: the CHA has no Ethernet, and ifup waits 15 seconds for a missing eth0
      _var_ifup_result=0
      for _var_interface in $(sed -n 's/^auto[[:space:]][[:space:]]*//p' /etc/network/interfaces)
      do
        if [ -e "/sys/class/net/$_var_interface" ]
        then
          /sbin/ifup "$_var_interface" || _var_ifup_result=1
        fi
      done
      [ $_var_ifup_result = 0 ] && echo "OK" || echo "FAIL"
    fi

    if iw dev wlan0 link | grep -q "Connected to";
    then
      # Automatically Updates System Time According to the NIST Atomic Clock
      # Give up after some tries, Wi-Fi may be connected without internet access
      _var_time_sync_tries=0
      while date | grep -q "1970" && [ $_var_time_sync_tries -lt 4 ];
      do
        _var_time_sync_tries=$((_var_time_sync_tries + 1))
        nistTime="$(/.choko/busybox wget -qS -T 10 http://example.com -O /dev/null 2>&1 | grep 'Date: ')"
        if [ -n "$nistTime" ]
        then
          dateString=$(echo $nistTime | cut -d' ' -f2-7)
          dayString=$(echo $nistTime | cut -d' ' -f2-2)
          dateValue=$(echo $nistTime | cut -d' ' -f3-3)
          monthValue=$(echo $nistTime | cut -d' ' -f4-4)
          yearValue=$(echo $nistTime | cut -d' ' -f5-5)
          timeValue=$(echo $nistTime | cut -d' ' -f6-6)
          timeZoneValue=$(echo $nistTime | cut -d' ' -f7-7)
          case $monthValue in
            "Jan")
                monthValue="01"
                ;;
            "Feb")
                monthValue="02"
                ;;
            "Mar")
                monthValue="03"
                ;;
            "Apr")
                monthValue="04"
                ;;
            "May")
                monthValue="05"
                ;;
            "Jun")
                monthValue="06"
                ;;
            "Jul")
                monthValue="07"
                ;;
            "Aug")
                monthValue="08"
                ;;
            "Sep")
                monthValue="09"
                ;;
            "Oct")
                monthValue="10"
                ;;
            "Nov")
                monthValue="11"
                ;;
            "Dec")
                monthValue="12"
                ;;
            *)
                sleep 5
                continue
          esac
          date --utc --set "$yearValue-$monthValue-$dateValue $timeValue" > /dev/null
        else
          sleep 5
        fi
      done
    fi
	;;
  stop)
    printf "Stopping network: "
    /sbin/ifdown -a
    [ $? = 0 ] && echo "OK" || echo "FAIL"
  ;;
  restart|reload)
    "$0" stop
    "$0" start
	;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
esac

exit $?
