#!/bin/sh

# /etc/init.d/S20joystick
# Choko Hack v13.2.0

start() {
  if [ -f "/opt/capcom/assets/controller.txt" ]
  then
    echo -e "\nSetting up external joystick..."
    killall -q js2hid2
    if [ ! -e /sys/kernel/config/usb_gadget/capcom_home_arcade/idProduct ]
    then
      # https://github.com/milador/RaspberryPi-Joystick/blob/master/8_Buttons_Joystick/8_buttons_joystick_usb
      # Load modules
      modprobe configfs
      modprobe libcomposite
      modprobe usb_f_hid

      mount -t configfs none /sys/kernel/config/

      sleep 1

      # Create joystick
      mkdir -p /sys/kernel/config/usb_gadget/capcom_home_arcade
      cd /sys/kernel/config/usb_gadget/capcom_home_arcade

      # Set up the device
      echo 0x1d6b > idVendor # Linux Foundation
      echo 0x0104 > idProduct # Multifunction Composite Joystick Gadget
      echo 0x0100 > bcdDevice # v1.0.0
      echo 0x0200 > bcdUSB # USB2

      # Multi Function Device - We need to do this to show as 2 sticks
      echo 0xEF > bDeviceClass
      echo 0x02 > bDeviceSubClass
      echo 0x01 > bDeviceProtocol

      mkdir -p strings/0x409

      echo "CHA001" > strings/0x409/serialnumber
      echo "Koch Media GmbH" > strings/0x409/manufacturer
      echo "Capcom Home Arcade Joystick" > strings/0x409/product

      # Define functions for 2 sticks
      mkdir -p functions/hid.usb0
      echo 0 > functions/hid.usb0/protocol
      echo 0 > functions/hid.usb0/subclass
      echo 3 > functions/hid.usb0/report_length
      # Report Descriptor - X, Y and 8 buttons
      echo -ne \\x05\\x01\\x09\\x05\\xA1\\x01\\x15\\x81\\x25\\x7F\\x09\\x01\\xA1\\x00\\x09\\x30\\x09\\x31\\x75\\x08\\x95\\x02\\x81\\x02\\xC0\\xA1\\x00\\x05\\x09\\x19\\x01\\x29\\x08\\x15\\x00\\x25\\x01\\x75\\x01\\x95\\x08\\x81\\x02\\xC0\\xC0 > functions/hid.usb0/report_desc
    
      mkdir -p functions/hid.usb1
      echo 0 > functions/hid.usb1/protocol
      echo 0 > functions/hid.usb1/subclass
      echo 3 > functions/hid.usb1/report_length
      # Report Descriptor - X, Y and 8 buttons
      echo -ne \\x05\\x01\\x09\\x05\\xA1\\x01\\x15\\x81\\x25\\x7F\\x09\\x01\\xA1\\x00\\x09\\x30\\x09\\x31\\x75\\x08\\x95\\x02\\x81\\x02\\xC0\\xA1\\x00\\x05\\x09\\x19\\x01\\x29\\x08\\x15\\x00\\x25\\x01\\x75\\x01\\x95\\x08\\x81\\x02\\xC0\\xC0 > functions/hid.usb1/report_desc

      mkdir -p configs/c.1
      mkdir -p configs/c.1/strings/0x409

      echo 0x80 > configs/c.1/bmAttributes
      echo 100 > configs/c.1/MaxPower # 100 mA
      echo "Capcom Home Arcade Joystick Configuration" > configs/c.1/strings/0x409/configuration

      ln -s functions/hid.usb0 configs/c.1
      ln -s functions/hid.usb1 configs/c.1

      # Activate it
      ls /sys/class/udc > /sys/kernel/config/usb_gadget/capcom_home_arcade/UDC
    fi
    sleep 2
    if [ -f /.choko/swapusbjoysticks ]
    then
      /usr/sbin/js2hid2 -s &
    else
      /usr/sbin/js2hid2 &
    fi
  fi
} > /dev/tty0
# ^This redirects text output to be visible on screen

stop() {
  if [ -f "/opt/capcom/assets/controller.txt" ]
  then
    killall -q js2hid2
    cd /
    [ -e /sys/kernel/config/usb_gadget/capcom_home_arcade ] && rm -rf /sys/kernel/config/usb_gadget/capcom_home_arcade
  fi
}

restart() {
  stop
  sleep 1
  start
}

case "$1" in
  start|stop|restart)
    "$1"
  ;;
  reload)
    # Restart, since there is no true "reload" feature.
    restart
  ;;
  *)
    echo "Usage: $0 {start|stop|restart|reload}" > /dev/tty0
    exit 1
  ;;
esac
